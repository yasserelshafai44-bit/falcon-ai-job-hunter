APP_ENV=production
DEBUG=false
LOCAL_PASSWORD_RESET_ENABLED=false
ACCESS_TOKEN_MINUTES=30
LOG_LEVEL=INFO
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_VALUE
CV_STORAGE_PATH=/tmp/falcon-cvs
PYTHONPATH=backend
# Render Free CV files are temporary and lost on restart/redeploy.
# render.yaml generates the JWT secret and references the existing database.
