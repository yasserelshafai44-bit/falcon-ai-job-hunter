APP_NAME=Falcon AI Job Hunter
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://falcon:falcon@db:5432/falcon
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
CV_STORAGE_PATH=backend/app/storage/cvs
MAX_CV_SIZE_MB=10
